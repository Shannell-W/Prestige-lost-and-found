# Copy this file to .env and fill in your own values. Never commit .env.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=prestige_db
DB_PORT=3306
PORT=5000
JWT_SECRET=change_this_secret
# Handling fee recorded when a claim is approved, in cents (10000 = KSh 100.00). Team decision.
CLAIM_FEE_CENTS=10000

# ---- Our API keys (security.js) ----
# Keys WE accept: one per consumer, as name:key, separated by commas. Every request needs one in X-API-Key.
# Make a key:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# prestige-web must match VITE_API_KEY in prestige-client/.env. Send team6 its key privately (direct message).
API_KEYS=team6:<team-6-key>,prestige-web:<website-key>,prestige-team:<our-testing-key>
# Each key may make RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_MS (100 per minute).
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ---- Upstream partner: Team 4 (Week 10) ----
# The address Team 4 gave us, WITHOUT /api at the end.
PARTNER_URL=https://artist-api-server.onrender.com
# The key Team 4 gave US for THEIR API (sent as x-api-key). Their Render server works without it.
PARTNER_API_KEY=<team-4-key-for-us>
# How long we keep Team 4's last answer (protects their rate limit, and covers Render waking up).
PARTNER_CACHE_MINUTES=20
PARTNER_TIMEOUT_MS=20000
