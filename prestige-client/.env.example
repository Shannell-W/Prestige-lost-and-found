# Copy to .env (in prestige-client) to point the website at a different server.
# Restart "npm run dev" after changing it.
VITE_API_URL=http://localhost:5000

# The website's own API key: one of the keys in server/.env API_KEYS (the "prestige-web" one).
# Never commit the real .env.
VITE_API_KEY=<your-website-api-key>
